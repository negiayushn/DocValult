# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key only. NEVER put the service_role key in this file.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# On Vercel with the Supabase integration you do not need the two lines above:
# it creates NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY, which the app also accepts.
